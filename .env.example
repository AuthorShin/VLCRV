# Copy to .env:  cp .env.example .env

# The PC that actually runs VLC and plays the video.
VLC_HOST=Your-PC
VLC_HTTP_PORT=8080
# Must match VLC -> Preferences -> All -> Interface -> Main interfaces -> Lua -> Lua HTTP -> Password
VLC_HTTP_PASSWORD=changeme

# Where the phone reaches this container (host networking = VM's LAN IP).
PORT=8004
# Optional: override the URL shown in the logs / QR code, e.g. behind a proxy.
PUBLIC_URL=

LOG_LEVEL=info
